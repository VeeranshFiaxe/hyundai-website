# Postgres connection string. This is the only database setting you need,
# whatever you deploy to (Netlify, a Node/nginx server, Vercel, ...).
# Add `?sslmode=require` for any database reached over the public internet.
#
# The one exception is Cloudflare Workers, where the HYPERDRIVE binding in
# wrangler.jsonc supplies the connection automatically and this can stay unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# WhatsApp relay used to deliver OTPs.
WHATSAPP_ENDPOINT_URL=
WHATSAPP_API_KEY=

# Signs the short-lived OTP challenge cookie. Any long random string.
# Optional: falls back to WHATSAPP_API_KEY when unset.
OTP_SECRET=

# Google Sheets relay used to mirror form submissions.
SHEET_ENDPOINT=
